  "tokenColors": [
    {
      "name": "Ordinary identifiers",
      "scope": [
        "variable",
        "identifier",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#D8E0F0"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#66708C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#7C86A2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Structural keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": ""
      }
    },
    {
      "name": "Control flow and behavior",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.return",
        "keyword.control.throw",
        "storage.modifier.async",
        "keyword.operator.expression.await"
      ],
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "meta.method-call variable.function"
      ],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#89DDFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "meta.parameters variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F78C6C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#C3E88D",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#B39DDB",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions and special literals",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "string.other.link",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#FF5370",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#D8E0F0"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F78C6C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F78C6C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#C3E88D"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#7C86A2"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#D8E0F0",
    "variable.readonly": "#B39DDB",
    "parameter": {
      "foreground": "#F78C6C",
      "italic": true
    },
    "property": "#D8E0F0",
    "property.readonly": "#B39DDB",
    "function": "#82AAFF",
    "method": "#82AAFF",
    "class": "#89DDFF",
    "interface": "#89DDFF",
    "struct": "#89DDFF",
    "enum": "#89DDFF",
    "enumMember": "#B39DDB",
    "type": "#89DDFF",
    "typeParameter": "#89DDFF",
    "namespace": "#89DDFF",
    "decorator": "#FF5370",
    "macro": "#FF5370",
    "keyword": "#C792EA",
    "string": "#C3E88D",
    "number": "#B39DDB",
    "regexp": "#FF5370",
    "operator": "#C792EA",
    "comment": {
      "foreground": "#66708C",
      "italic": true
    }
  }
}
