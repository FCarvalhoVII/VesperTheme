  "tokenColors": [
    {
      "name": "Ordinary identifiers",
      "scope": [
        "variable",
        "identifier",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#DCEAF2"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#607787",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#708695",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Structural keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#7DD3FC",
        "fontStyle": ""
      }
    },
    {
      "name": "Control flow and behavior",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.return",
        "keyword.control.throw",
        "storage.modifier.async",
        "keyword.operator.expression.await"
      ],
      "settings": {
        "foreground": "#7DD3FC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "meta.method-call variable.function"
      ],
      "settings": {
        "foreground": "#A5F3FC",
        "fontStyle": ""
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#BAE6FD",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "meta.parameters variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#93C5FD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#C4E6D4",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#CBD5FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions and special literals",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "string.other.link",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#67E8F9",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#DCEAF2"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#BAE6FD"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#93C5FD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#BAE6FD"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#A5F3FC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#93C5FD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#7DD3FC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#C4E6D4"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#F87171"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#708695"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#DCEAF2",
    "variable.readonly": "#CBD5FF",
    "parameter": {
      "foreground": "#93C5FD",
      "italic": true
    },
    "property": "#DCEAF2",
    "property.readonly": "#CBD5FF",
    "function": "#A5F3FC",
    "method": "#A5F3FC",
    "class": "#BAE6FD",
    "interface": "#BAE6FD",
    "struct": "#BAE6FD",
    "enum": "#BAE6FD",
    "enumMember": "#CBD5FF",
    "type": "#BAE6FD",
    "typeParameter": "#BAE6FD",
    "namespace": "#BAE6FD",
    "decorator": "#67E8F9",
    "macro": "#67E8F9",
    "keyword": "#7DD3FC",
    "string": "#C4E6D4",
    "number": "#CBD5FF",
    "regexp": "#67E8F9",
    "operator": "#7DD3FC",
    "comment": {
      "foreground": "#607787",
      "italic": true
    }
  }
}
