  "tokenColors": [
    {
      "name": "Ordinary identifiers",
      "scope": [
        "variable",
        "identifier",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#E8DDC4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#7F7566",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#978B77",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Structural keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#C99A4A",
        "fontStyle": ""
      }
    },
    {
      "name": "Control flow and behavior",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.return",
        "keyword.control.throw",
        "storage.modifier.async",
        "keyword.operator.expression.await"
      ],
      "settings": {
        "foreground": "#C99A4A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "meta.method-call variable.function"
      ],
      "settings": {
        "foreground": "#D8B56A",
        "fontStyle": ""
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#E3CC9A",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "meta.parameters variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#B66A5E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#C7B377",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#C99A4A"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#A86F59",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions and special literals",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "string.other.link",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#8F3F4A",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#C99A4A"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#E8DDC4"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#E3CC9A"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#8F3F4A"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C99A4A"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B66A5E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#E3CC9A"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#D8B56A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#B66A5E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C99A4A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#A9A47E"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#C7B377"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#C95B5B"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#978B77"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#E8DDC4",
    "variable.readonly": "#A86F59",
    "parameter": {
      "foreground": "#B66A5E",
      "italic": true
    },
    "property": "#E8DDC4",
    "property.readonly": "#A86F59",
    "function": "#D8B56A",
    "method": "#D8B56A",
    "class": "#E3CC9A",
    "interface": "#E3CC9A",
    "struct": "#E3CC9A",
    "enum": "#E3CC9A",
    "enumMember": "#A86F59",
    "type": "#E3CC9A",
    "typeParameter": "#E3CC9A",
    "namespace": "#E3CC9A",
    "decorator": "#8F3F4A",
    "macro": "#8F3F4A",
    "keyword": "#C99A4A",
    "string": "#C7B377",
    "number": "#A86F59",
    "regexp": "#8F3F4A",
    "operator": "#C99A4A",
    "comment": {
      "foreground": "#7F7566",
      "italic": true
    }
  }
}
