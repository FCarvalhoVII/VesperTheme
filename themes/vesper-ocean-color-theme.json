  "tokenColors": [
    {
      "name": "Ordinary identifiers",
      "scope": [
        "variable",
        "identifier",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#D3E6ED"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#5D7884",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#698794",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Structural keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#5BB9FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Control flow and behavior",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.return",
        "keyword.control.throw",
        "storage.modifier.async",
        "keyword.operator.expression.await"
      ],
      "settings": {
        "foreground": "#5BB9FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "meta.method-call variable.function"
      ],
      "settings": {
        "foreground": "#45D6D0",
        "fontStyle": ""
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#7DDCE5",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "meta.parameters variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#FF9B8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9ED7B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#5BB9FF"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#A6B8FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions and special literals",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "string.other.link",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#FF7F73",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#5BB9FF"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#D3E6ED"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#7DDCE5"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#FF7F73"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#5BB9FF"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FF9B8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#7DDCE5"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#45D6D0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FF9B8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#5BB9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#4FB7E8"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9ED7B3"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF6B6B"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#698794"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#D3E6ED",
    "variable.readonly": "#A6B8FF",
    "parameter": {
      "foreground": "#FF9B8C",
      "italic": true
    },
    "property": "#D3E6ED",
    "property.readonly": "#A6B8FF",
    "function": "#45D6D0",
    "method": "#45D6D0",
    "class": "#7DDCE5",
    "interface": "#7DDCE5",
    "struct": "#7DDCE5",
    "enum": "#7DDCE5",
    "enumMember": "#A6B8FF",
    "type": "#7DDCE5",
    "typeParameter": "#7DDCE5",
    "namespace": "#7DDCE5",
    "decorator": "#FF7F73",
    "macro": "#FF7F73",
    "keyword": "#5BB9FF",
    "string": "#9ED7B3",
    "number": "#A6B8FF",
    "regexp": "#FF7F73",
    "operator": "#5BB9FF",
    "comment": {
      "foreground": "#5D7884",
      "italic": true
    }
  }
}
